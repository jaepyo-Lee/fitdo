FROM openjdk:17-alpine
ARG JAR_FILE=build/libs/*.jar
ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Seoul
COPY ${JAR_FILE} app.jar

ARG DB_URL_ARG
ARG DB_USERNAME_ARG
ARG DB_PASSWORD_ARG
ARG DB_DDL_TYPE_ARG
ARG ELASTICCACHE_HOST_ARG
ARG DISCORD_WEBHOOK_URI_ARG

ENV DISCORD_WEBHOOK_URI=${DISCORD_WEBHOOK_URI_ARG}
ENV DB_URL=${DB_URL_ARG}
ENV DB_USERNAME=${DB_USERNAME_ARG}
ENV DB_PASSWORD=${DB_PASSWORD_ARG}
ENV DB_DDL_TYPE=${DB_DDL_TYPE_ARG}
ENV ELASTICCACHE_HOST=${ELASTICCACHE_HOST_ARG}
ENV SPRING_PROFILES_ACTIVE=dev

ENTRYPOINT ["java","-jar","/app.jar"]